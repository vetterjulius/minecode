{
  "name": "minecode-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Minecode: Declarative AI-First Software Composition System",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . && pnpm check-boundaries && pnpm check-circular",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,yaml,yml}\"",
    "check-boundaries": "node scripts/validate-package-boundaries.js",
    "check-circular": "dpdm --exit-code circular:1 \"composition-engine/packages/*/src/**/*.ts\" \"composition-engine/apps/*/src/**/*.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^3.0.5",
    "dpdm": "^4.3.0",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.15.0",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
